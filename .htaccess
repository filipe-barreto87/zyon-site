# Zyon Tecnologia — site estático. Servidor: LiteSpeed (honra .htaccess Apache).
#
# TUDO aqui é mod_rewrite de propósito. Este servidor ignora as diretivas de
# mod_alias (Redirect/RedirectMatch) e aborta o resto do arquivo ao encontrá-las:
# na primeira publicação, os 301 das URLs antigas e o ErrorDocument nunca
# dispararam porque vinham depois de um RedirectMatch. Não reintroduzir.

ErrorDocument 404 /404.html

RewriteEngine On

# A validação de certificado (AutoSSL) tem de passar sempre, inclusive em http.
RewriteRule ^\.well-known/ - [L]

# ---------- canonicalização ----------
# ESCOPO POR HOST é obrigatório: o e-mail vive no MESMO servidor e IP, e em
# cPanel mail./webmail./cpanel. compartilham este docroot. Sem o RewriteCond de
# Host, "http://webmail.zyontecnologia.com.br/" seria sequestrado para o site.
# E o TLS termina num proxy, então %{HTTPS} chega vazio: testar só ele faria a
# regra redirigir para si mesma em loop.
RewriteCond %{HTTP_HOST} ^(www\.)?zyontecnologia\.com\.br$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{HTTP:X-Forwarded-SSL} !=on
RewriteRule ^(.*)$ https://zyontecnologia.com.br/$1 [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.zyontecnologia\.com\.br$ [NC]
RewriteRule ^(.*)$ https://zyontecnologia.com.br/$1 [R=301,L]

# ---------- URLs do site WordPress anterior ----------
# O slug deste post trazia um emoji (…-%f0%9f%9a%80). O padrão casa qualquer
# sufixo depois do slug limpo, então não depende de como o servidor decodifica.
RewriteRule ^evolucao-e-inovacao-nossa-jornada-rumo-a-gestao-documental-.+$ /evolucao-e-inovacao-nossa-jornada-rumo-a-gestao-documental/ [R=301,L]

# páginas padrão do WordPress que nunca foram conteúdo
RewriteRule ^hello-world/?$ / [R=301,L]
RewriteRule ^sample-page/?$ / [R=301,L]

# a antiga política de cookies virou a política de privacidade
RewriteRule ^politica-de-cookies/?$ /politica-de-privacidade.html [R=301,L]

# arquivos gerados pelo WordPress que respondiam 200 e sumiriam sem aviso
RewriteRule ^(category|categoria|tag|author)(/.*)?$ /artigos/ [R=301,L]
RewriteRule ^[0-9]{4}(/[0-9]{2})?(/[0-9]{2})?/?$ /artigos/ [R=301,L]
RewriteRule ^(feed|comments/feed)/?$ /artigos/ [R=301,L]
RewriteRule ^wp-sitemap.*\.xml$ /sitemap.xml [R=301,L]

# restos do WordPress: não deixar 404 nem sinalizar que existiu um WP aqui
RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|wp-json)(/.*)?$ / [R=301,L]
RewriteRule ^wp-(content|includes)/ - [R=404,L]

# /politica-de-privacidade (sem extensão) serve o arquivo .html
RewriteRule ^politica-de-privacidade/?$ /politica-de-privacidade.html [L]

# ---------- o que este host NÃO deixa o .htaccess controlar ----------
# Testado em produção, não suposto: neste LiteSpeed as diretivas Header,
# ExpiresByType e AddOutputFilterByType são aceitas sem erro e simplesmente
# ignoradas — o servidor aplica a própria política. Medido depois do corte:
#   gzip ................. ligado pelo servidor (content-encoding: gzip)
#   estáticos ............ Cache-Control: public, max-age=604800 (7 dias)
#   HTML e JS ............ sem Cache-Control
#   X-Frame-Options, X-Content-Type-Options, Referrer-Policy ... não emitidos
# Deixar as diretivas aqui daria a impressão falsa de que estão valendo, então
# foram removidas. Para ativá-las de fato é preciso o painel da hospedagem
# (cPanel) ou pedir à revenda — não dá para fazer por FTP.
# CSS e JS carregam ?v= na URL, então os 7 dias do servidor não impedem que uma
# publicação nova chegue ao visitante.

# AddType é honrado (verificado: o woff2 sai como font/woff2).
AddType font/woff2 .woff2
AddType image/webp .webp

DirectoryIndex index.html
